// ─────────────────────────────────────────────────────────────────────────────
// RESQ Platform · Firestore Security Rules
// ─────────────────────────────────────────────────────────────────────────────
// Role-based access control using Firebase Auth custom claims.
//
// Roles:
//   citizen   → Read own profile, read public data, write own incidents/SOS
//   authority → Everything citizen can do + verify incidents, manage operations
//   admin     → Full read/write to all collections
//
// Deploy with:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user's role from custom claims (defaults to 'citizen')
    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'citizen';
    }

    // Check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    // Check if user has one of the specified roles
    function hasAnyRole(roles) {
      return isAuthenticated() && getUserRole() in roles;
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Check if user is authority or admin
    function isAuthorityOrAdmin() {
      return hasAnyRole(['authority', 'admin']);
    }

    // Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // USER PROFILES — /users/{userId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Users can read/update their own profile
    // - Authority can read any user profile (for incident response)
    // - Admin has full access
    // - Nobody can self-assign a privileged role
    // ═══════════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthorityOrAdmin();

      // Users can create their own profile on first login
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'citizen';

      // Users can update their own profile EXCEPT the role field
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // INCIDENTS — /incidents/{incidentId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Any authenticated user can read incidents
    // - Citizens can create incidents (with their own UID as reportedBy)
    // - Authority/Admin can update (verify, assign, change status)
    // - Admin can delete
    // ═══════════════════════════════════════════════════════════════════════════
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.reportedByUid == request.auth.uid;

      allow update: if isAuthorityOrAdmin()
                    || (isOwner(resource.data.reportedByUid) 
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'status']));

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // SOS BEACONS — /sos_beacons/{beaconId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Citizens create their own SOS beacons
    // - Authority/Admin can read all beacons and update dispatch status
    // - Owner can read and deactivate their own beacon
    // ═══════════════════════════════════════════════════════════════════════════
    match /sos_beacons/{beaconId} {
      allow read: if isOwner(resource.data.userId) || isAuthorityOrAdmin();

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isOwner(resource.data.userId) || isAuthorityOrAdmin();

      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // FACILITIES — /facilities/{facilityId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Any authenticated user can read (shelters, hospitals, blood banks)
    // - Only Admin can create/update/delete
    // ═══════════════════════════════════════════════════════════════════════════
    match /facilities/{facilityId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // ALERTS — /alerts/{alertId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Any authenticated user can read alerts
    // - Authority/Admin can create and update alerts
    // - Only Admin can delete
    // ═══════════════════════════════════════════════════════════════════════════
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthorityOrAdmin();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // RESOURCE ALLOCATIONS — /resources/{resourceId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Authenticated users can read (transparency)
    // - Authority/Admin can manage
    // ═══════════════════════════════════════════════════════════════════════════
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthorityOrAdmin();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // OPERATIONS LOG — /operations/{opId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Authority/Admin read and write operational logs
    // ═══════════════════════════════════════════════════════════════════════════
    match /operations/{opId} {
      allow read, write: if isAuthorityOrAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // SYSTEM CONFIG — /config/{configId}
    // ═══════════════════════════════════════════════════════════════════════════
    // - Admin only — system-wide settings, region configs, etc.
    // ═══════════════════════════════════════════════════════════════════════════
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════════════
    // CATCH-ALL — Deny everything else
    // ═══════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

